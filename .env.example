# ── Database ─────────────────────────────────────────────
# Local option A: docker compose up -d  →  postgresql://wa:wa@localhost:5433/wa_dashboard
# Local option B (no Docker): npx prisma dev --name wa-dashboard --detach --db-port 51214
#   →  postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Supabase: use the pooled (6543, ?pgbouncer=true) URL here and the direct (5432) URL in DIRECT_URL
DATABASE_URL=postgresql://wa:wa@localhost:5433/wa_dashboard
DIRECT_URL=

# ── WhatsApp Cloud API (Meta) — set by our team, never shown to the client ──
WA_GRAPH_VERSION=v26.0
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Permanent System User token. Temporary tokens from the API Setup page expire every 24h.
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
# Messages per second the queue sends (keep it gentle)
WA_SEND_RATE_PER_SEC=10
# Max new customers messaged first per rolling 24h (Meta's limit for this number: 250 unverified, 2000 verified).
# Extra messages wait quietly and go out when slots free up. 0 = don't hold anything back.
WA_DAILY_LIMIT=250

# ── Client login & branding ──────────────────────────────
ADMIN_EMAIL=owner@example.com
# First password. The client can change it later from Account.
ADMIN_PASSWORD=change-me
# Random 32+ char string used to sign the login cookie: openssl rand -base64 32
AUTH_SECRET=
# Default business name/logo (the client can edit both from Account)
APP_NAME=Your Business
APP_LOGO_URL=D:\internwhatsapp\image.png
# Our support contact, shown on Account and the login page
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Bearer secret for /api/cron/process (Vercel Cron sends it automatically; cron-job.org: add ?key=...)
CRON_SECRET=

# ── Demo ─────────────────────────────────────────────────
# Comma-separated phones used for the first sample contacts by `npm run seed`
DEMO_RECIPIENTS=
