// WhatsApp Broadcast & Automation Dashboard — data model.
// The whole schema is defined up front so later phases don't need disruptive migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Contacts & groups ─────────────────────────

model Contact {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique // E.164, e.g. +919876543210
  city          String?
  email         String?
  notes         String?
  optedIn       Boolean   @default(false)
  optedInAt     DateTime?
  optedOutAt    DateTime?
  // Start of the 24h customer-service window is computed from this.
  lastInboundAt DateTime?
  /// Free-form labels shown as chips (VIP, Wholesale…). Groups are the main way to segment.
  tags          String[]  @default([])
  /// Set when WhatsApp reports the number can't receive messages (e.g. not on WhatsApp).
  undeliverable Boolean   @default(false)
  /// Chat list helpers, kept denormalised so the inbox stays fast.
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  groups    ContactGroup[]
  messages  Message[]
  optEvents OptEvent[]

  @@index([optedIn])
  @@index([lastInboundAt])
  @@index([lastMessageAt])
}

/// App-side segment (tag). NOT a WhatsApp group — broadcasts go to individual chats.
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ContactGroup[]
}

model ContactGroup {
  contactId String
  groupId   String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@index([groupId])
}

enum OptEventType {
  OPT_IN
  OPT_OUT
}

enum OptEventSource {
  MANUAL
  IMPORT
  KEYWORD // contact replied STOP / unsubscribe
  SEED
}

model OptEvent {
  id        String         @id @default(cuid())
  contactId String
  type      OptEventType
  source    OptEventSource
  note      String?
  createdAt DateTime       @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

// ───────────────────────── Templates ─────────────────────────

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT // saved locally, never submitted to this WABA
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  IN_APPEAL
  UNKNOWN
}

/// Our own copy of a template definition. Portable across WhatsApp Business Accounts.
model Template {
  id        String           @id @default(cuid())
  /// Friendly title the business sees ("Diwali offer"). `name` is the Meta-side identifier.
  title     String?
  name      String // lowercase_with_underscores
  language  String           @default("en")
  category  TemplateCategory
  header    String? // text header only (media headers are out of scope)
  body      String
  footer    String?
  /// [{ type: "QUICK_REPLY" | "URL" | "PHONE_NUMBER", text, url?, phone_number?, example? }]
  buttons   Json             @default("[]")
  /// { header?: string[], body: string[] } sample values Meta needs for review
  examples  Json             @default("{}")
  /// One entry per body variable, in order: [{ label: "Customer name", kind: "name" | "detail" }]
  variables Json             @default("[]")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  submissions TemplateSubmission[]
  broadcasts  Broadcast[]

  @@unique([name, language])
}

/// The state of one Template on one WhatsApp Business Account.
model TemplateSubmission {
  id              String         @id @default(cuid())
  templateId      String
  wabaId          String
  metaTemplateId  String?
  status          TemplateStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, wabaId])
  @@index([metaTemplateId])
}

// ───────────────────────── Broadcasts & messages ─────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  CANCELLED
  COMPLETED
}

model Broadcast {
  id           String          @id @default(cuid())
  name         String
  templateId   String
  /// { type: "groups", groupIds: [] } | { type: "all" } | { type: "contacts", contactIds: [] }
  audience     Json
  /// { "body.1": { source: "field", field: "name", fallback: "there" } | { source: "text", value: "..." }, ... }
  variableMap  Json            @default("{}")
  status       BroadcastStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  recipientCount Int           @default(0)
  /// Snapshot of the estimate shown before sending (INR, incl. GST).
  estimatedCost  Decimal?      @db.Decimal(12, 4)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  template Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  messages Message[]

  @@index([status, scheduledAt])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENDING // claimed by a worker
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  RECEIVED // inbound
}

/// Every message in or out. Outbound QUEUED rows double as the send queue (outbox pattern).
model Message {
  id          String           @id @default(cuid())
  direction   MessageDirection
  contactId   String
  broadcastId String?
  type        String // template | text | button | image | ...
  /// Human-readable rendered text for the inbox / detail tables.
  body        String?
  templateName String?
  templateLang String?
  /// Provider-ready send payload (template components or text body).
  payload     Json?
  wamid       String?          @unique
  status      MessageStatus
  errorCode   String?
  errorTitle  String?
  errorDetail String?
  attempts    Int              @default(0)
  nextAttemptAt DateTime?
  lockedAt    DateTime?
  queuedAt    DateTime         @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  receivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([broadcastId, status])
  @@index([contactId, createdAt])
  @@index([direction, createdAt])
}

// ───────────────────────── Webhooks ─────────────────────────

model WebhookEvent {
  id          String    @id @default(cuid())
  /// Stable hash of the payload — Meta may deliver the same event twice.
  dedupeKey   String    @unique
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([processedAt])
}

// ───────────────────────── Account ─────────────────────────

/// Small key/value store for business profile and login settings managed from the Account page.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Saved answers for the Chats screen.
model QuickReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
